generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  INSTRUCTOR
  MEMBER
}

enum SessionType {
  POLE_CLASS
  TRIAL
  PRACTICE
  RENTAL
}

enum BookingMode {
  PACKAGE_ONLY
  WALK_IN_ONLY
  BOTH
}

enum SessionStatus {
  PENDING_INSTRUCTOR
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  PAID_AWAITING_RESOLUTION
}

enum PackageStatus {
  PENDING_REVIEW
  ACTIVE
  EXHAUSTED
  EXPIRED
  REJECTED
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDITS
}

enum Attendance {
  UNMARKED
  PRESENT
  ABSENT
  NO_SHOW
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  name         String
  passwordHash String
  role         Role              @default(MEMBER)
  credits      Int               @default(0)
  createdAt    DateTime          @default(now())
  instructor   Instructor?
  bookings     Booking[]
  packages     MemberPackage[]
  proofs       PaymentProof[]
  ledger       CreditLedger[]
  notifications Notification[]
  requests     TimeslotRequest[]
  conversations ChatConversation[]
  assignedChats ChatConversation[] @relation("AssignedAdminChats")
}

model Instructor {
  id         String            @id @default(uuid())
  userId     String?           @unique
  user       User?             @relation(fields: [userId], references: [id])
  email      String            @unique
  name       String
  phone      String?
  bio        String            @default("")
  specialty  String            @default("Pole foundations")
  autoAccept Boolean           @default(false)
  sessions   Session[]
  blocks     UnavailableSlot[]
  chatConversations ChatConversation[]
}

model PackageProduct {
  id             String          @id @default(uuid())
  name           String
  description    String          @default("")
  credits        Int
  price          Int
  validityDays   Int             @default(30)
  allowedTypes   SessionType[]   @default([POLE_CLASS])
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  memberPackages MemberPackage[]
}

model MemberPackage {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  packageProductId String
  packageProduct  PackageProduct  @relation(fields: [packageProductId], references: [id])
  creditsTotal     Int
  creditsRemaining Int
  pricePaid        Int
  status           PackageStatus   @default(PENDING_REVIEW)
  proofId          String?         @unique
  proof            PaymentProof?   @relation(fields: [proofId], references: [id])
  rejectionReason  String?
  activatedAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime        @default(now())
  bookings         Booking[]
  ledgerEntries    CreditLedger[]

  @@index([userId, status])
  @@index([expiresAt])
}

model Session {
  id           String        @id @default(uuid())
  title        String
  type         SessionType
  bookingMode  BookingMode   @default(BOTH)
  creditCost   Int           @default(1)
  startsAt     DateTime
  endsAt       DateTime
  capacity     Int
  price        Int
  level        String        @default("All levels")
  description  String        @default("")
  instructorId String?
  instructor   Instructor?   @relation(fields: [instructorId], references: [id])
  status       SessionStatus
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  bookings     Booking[]

  @@index([startsAt, status])
  @@index([instructorId, startsAt])
}

model UnavailableSlot {
  id           String     @id @default(uuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id])
  startsAt     DateTime
  endsAt       DateTime
  reason       String     @default("")

  @@index([instructorId, startsAt])
}

model PaymentProof {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  filename      String
  mime          String
  createdAt     DateTime       @default(now())
  booking       Booking?
  memberPackage MemberPackage?
}

model Booking {
  id              String        @id @default(uuid())
  memberId        String
  member          User          @relation(fields: [memberId], references: [id])
  sessionId       String
  session         Session       @relation(fields: [sessionId], references: [id])
  status          BookingStatus @default(PENDING)
  paymentMethod   PaymentMethod
  packageId       String?
  package         MemberPackage? @relation(fields: [packageId], references: [id])
  creditsUsed     Int           @default(0)
  proofId         String?       @unique
  proof           PaymentProof? @relation(fields: [proofId], references: [id])
  amount          Int
  discount        Int           @default(0)
  promoCode       String?
  creditReserved  Boolean       @default(false)
  attendance      Attendance    @default(UNMARKED)
  rejectionReason String?
  overrideReason  String?
  createdAt       DateTime      @default(now())

  @@index([memberId, status])
  @@index([sessionId, status])
}

model CreditLedger {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  packageId String?
  package   MemberPackage? @relation(fields: [packageId], references: [id])
  delta     Int
  reason    String
  bookingId String?
  createdAt DateTime       @default(now())

  @@index([userId, createdAt])
}

model Promotion {
  id        String   @id @default(uuid())
  code      String   @unique
  percent   Int
  expiresAt DateTime
  active    Boolean  @default(true)
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  readAt    DateTime?
  dedupeKey String?   @unique
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model TimeslotRequest {
  id        String      @id @default(uuid())
  memberId  String
  member    User        @relation(fields: [memberId], references: [id])
  type      SessionType
  startsAt  DateTime
  endsAt    DateTime
  note      String      @default("")
  status    String      @default("PENDING")
  response  String?
  createdAt DateTime    @default(now())

  @@index([memberId, status])
}

enum ChatSenderType {
  USER
  BOT
  AI
  ADMIN
  INSTRUCTOR
}

enum ChatStatus {
  BOT
  AI
  WAITING_ADMIN
  ADMIN_ACTIVE
  RESOLVED
}

model ChatConversation {
  id              String         @id @default(uuid())
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  visitorName     String         @default("Guest Member")
  visitorEmail    String?
  status          ChatStatus     @default(BOT)
  assignedAdminId String?
  assignedAdmin   User?          @relation("AssignedAdminChats", fields: [assignedAdminId], references: [id])
  instructorId    String?
  instructor      Instructor?    @relation(fields: [instructorId], references: [id])
  primaryTopic    String?
  resolvedAt                     DateTime?
  resolvedByRole                 String?
  instructorPermissionRequested  Boolean        @default(false)
  instructorPermissionReason     String?
  instructorPermissionRequestedAt DateTime?
  instructorPermissionGranted    Boolean        @default(false)
  gapStartTime                   DateTime?
  gapEndTime                     DateTime?
  hideGapMessagesFromInstructor  Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  messages        ChatMessage[]

  @@index([userId])
  @@index([status])
  @@index([instructorId])
  @@index([assignedAdminId])
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     ChatSenderType
  senderId       String?
  senderName     String
  content        String
  faqId          String?
  faq            FaqQuestion?     @relation(fields: [faqId], references: [id], onDelete: SetNull)
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([senderType])
}

model FaqQuestion {
  id        String        @id @default(uuid())
  category  String        @default("General")
  question  String
  answer    String
  keywords  String        @default("")
  hitCount  Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([category])
  @@index([hitCount])
}
